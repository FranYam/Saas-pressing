#!/bin/sh
# Garde-fou anti-fuite : bloque tout commit contenant une chaîne littérale
# ressemblant à un mot de passe (exigence : plus jamais d'alerte GitGuardian).
#
# Règle du projet : les identifiants de test sont générés à l'exécution via
# apps/core/tests/utils.py::fake_password() — jamais écrits en dur.

pattern="(password|passwd|pass|secret|token)['\"]? ?[:=] ?['\"][^'\"]{8,}['\"]"

added=$(git diff --cached -U0 | grep -E "^\+" | grep -vE "^\+\+\+")

if echo "$added" | grep -Eiq "$pattern"; then
    echo ""
    echo "COMMIT BLOQUE : chaine ressemblant a un mot de passe detectee."
    echo "  -> Générez la valeur à l'exécution : apps/core/tests/utils.py::fake_password()"
    echo "  -> Contournement ponctuel (déconseillé) : git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
