# =============================================================================
# Configuration locale — copier ce fichier en `.env` puis adapter les valeurs.
# Ne jamais committer le vrai `.env` (il est ignoré par git).
# =============================================================================

# Module de settings à charger (config.settings.dev | config.settings.prod)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Clé secrète Django. Obligatoire en production.
# Générer une clé : py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# -----------------------------------------------------------------------------
# Base de données
# - En dev local sans DATABASE_URL : bascule automatique sur SQLite.
# - Neon + pooler PgBouncer (mode transaction), l'URL contient `-pooler` :
# DATABASE_URL=postgres://<USER>:<MOT_DE_PASSE>@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Origines CORS autorisées (séparées par des virgules) — URLs de la PWA
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# JWT (authentification principale de l'API)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# Production uniquement
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SENTRY_DSN=
